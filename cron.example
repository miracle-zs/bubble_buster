# Preferred mode: run one long-lived service process.
#   /usr/bin/python3 /Users/zhangshuai/PycharmProjects/bubble_buster/main.py --config /Users/zhangshuai/PycharmProjects/bubble_buster/config.ini service
#
# Keep cron only as fallback or for explicit one-shot tasks.
CRON_TZ=Asia/Shanghai

# Fallback: one-shot daily loss-cut (optional)
55 11 * * * /usr/bin/python3 /Users/zhangshuai/PycharmProjects/bubble_buster/main.py --config /Users/zhangshuai/PycharmProjects/bubble_buster/config.ini loss-cut

# Optional dashboard process (if not managed by systemd/supervisor)
# */5 * * * * /usr/bin/python3 /Users/zhangshuai/PycharmProjects/bubble_buster/main.py --config /Users/zhangshuai/PycharmProjects/bubble_buster/config.ini dashboard --host 127.0.0.1 --port 8787
