[binance]
api_key =
api_secret =
base_url = https://fapi.binance.com
timeout_sec = 10
retry_count = 3
retry_delay_sec = 1
recv_window = 5000
http_pool_maxsize = 64

[strategy]
leverage = 2
top_n = 10
volume_threshold = 0
tp_price_drop_pct = 20
fixed_take_profit_enabled = false
sl_liq_buffer_pct = 1
max_hold_hours = 47.5
trigger_price_type = CONTRACT_PRICE
allocation_splits = 10
entry_fee_buffer_pct = 1.0
entry_shrink_retry_count = 3
entry_shrink_step_pct = 10.0
entry_rank_fetch_multiplier = 3
entry_wait_bearish_hour_enabled = true
entry_wait_poll_sec = 30
entry_wait_close_grace_sec = 1
entry_wait_close_retry_sec = 1
entry_wait_close_retry_count = 5
entry_wait_max_hours = 16
entry_preclose_sec = 10
ranker_max_workers = 24
ranker_weight_limit_per_minute = 1000
ranker_min_request_interval_ms = 20
rebalance_enabled = true
rebalance_pre_entry_reduce = true
rebalance_after_entry = true
rebalance_utilization = 0.97
rebalance_deadband_pct = 0.03
rebalance_min_adjust_notional_usdt = 1.0
rebalance_max_single_adjust_pct = 0.80
rebalance_max_adjust_orders = 30
rebalance_mode = equal_risk
rebalance_age_decay_half_life_hours = 36.0
equity_recovery_take_profit_enabled = false
equity_recovery_lookback_hours = 24.0
equity_recovery_trigger_pct = 0.09
equity_recovery_reduce_ratio = 0.50

[runtime]
timezone = Asia/Shanghai
# Accounts sharing one Binance source IP must use the same rate-limit scope.
binance_rate_limit_scope = binance-futures-ip
entry_hour = 7
entry_minute = 40
entry_misfire_grace_min = 20
entry_catchup_enabled = true
daily_loss_cut_enabled = true
daily_loss_cut_hour = 11
daily_loss_cut_minute = 55
daily_loss_cut_grace_min = 30
daily_loss_cut_scope = exchange
portfolio_loss_cut_enabled = true
portfolio_loss_cut_pct = 3.5
portfolio_loss_cut_hour = 8
portfolio_loss_cut_minute = 0
portfolio_take_profit_enabled = false
portfolio_take_profit_pct = 2.5
portfolio_take_profit_giveback_pct = 15.0
portfolio_take_profit_hour = 8
portfolio_take_profit_minute = 0
portfolio_take_profit_reduce_ratio = 1.0
morning_protection_enabled = true
morning_protection_hour = 7
morning_protection_minute = 55
morning_protection_min_hold_hours = 6
hourly_exchange_take_profit_enabled = true
hourly_exchange_take_profit_minute = 0
hourly_exchange_take_profit_drop_pct = 18
manager_interval_sec = 60
manager_max_catch_up_runs = 3
orphan_exit_order_cleanup_enabled = true
orphan_exit_order_cleanup_hour = 3
orphan_exit_order_cleanup_minute = 30
service_loop_sleep_sec = 1.0
run_manage_on_startup = true
default_account_id = acc01
max_account_workers = 4
account_failure_threshold = 3
account_cooldown_cycles = 2
account_task_timeout_sec = 7200
wallet_snapshot_asset = USDT
readonly_wallet_snapshot_interval_sec = 60
sync_cashflows = true
cashflow_income_types = TRANSFER,WELCOME_BONUS
dashboard_host = 127.0.0.1
dashboard_port = 8787
dashboard_refresh_sec = 5
dashboard_curve_points = 1200
run_service_with_dashboard = true
lock_file = runtime.lock
lock_wait_sec = 30
db_path = state.db
log_dir = logs
log_level = INFO

[accounts]
enabled = acc01,acc02,acc03,acc04,readonly01,readonly02
mode.acc01 = full
mode.acc02 = full
mode.acc03 = full
mode.acc04 = full
# mode.55 = loss_cut_only
mode.readonly01 = readonly
mode.readonly02 = readonly
strategy_note.acc01 = 每日08:00权益+9%组合减仓50% / 组合止损3.5% / 中午保护止损ON / 早盘保护止损ON / 盈利18%回撤止盈保护
strategy_note.acc02 = 每日08:00权益+9%组合清仓 / 组合止损3.5% / 中午保护止损ON / 早盘保护止损ON / 盈利18%回撤止盈保护
strategy_note.acc03 = 每日08:00权益+9%组合清仓 / 组合止损3.5% / 中午保护止损ON / 早盘保护止损ON / 盈利18%回撤止盈保护
strategy_note.acc04 = 组合止盈OFF / 组合止损3.5% / 中午保护止损ON / 早盘保护止损ON / 盈利18%回撤止盈保护
# strategy_note.55 = loss_cut_only / 中午保护止损ON / 盈利18%回撤止盈保护
strategy_note.readonly01 = 只读监控账户 / 余额曲线 / 交易统计
strategy_note.readonly02 = 只读监控账户 / 余额曲线 / 交易统计

[account.acc01.binance]
api_key = REPLACE_WITH_ACC01_API_KEY
api_secret = REPLACE_WITH_ACC01_API_SECRET

[account.acc02.binance]
api_key = REPLACE_WITH_ACC02_API_KEY
api_secret = REPLACE_WITH_ACC02_API_SECRET

[account.acc03.binance]
api_key = REPLACE_WITH_ACC03_API_KEY
api_secret = REPLACE_WITH_ACC03_API_SECRET

[account.acc04.binance]
api_key = REPLACE_WITH_ACC04_API_KEY
api_secret = REPLACE_WITH_ACC04_API_SECRET

[account.55.binance]
api_key = REPLACE_WITH_ACC55_API_KEY
api_secret = REPLACE_WITH_ACC55_API_SECRET

# readonly 模式账户示例：只需要只读权限的 API Key
# 功能：余额曲线展示、交易统计、Dashboard 监控
# 不参与：建仓、仓位管理、止损保护等交易操作
[account.readonly01.binance]
api_key = REPLACE_WITH_READONLY_API_KEY
api_secret = REPLACE_WITH_READONLY_API_SECRET

[account.readonly02.binance]
api_key = REPLACE_WITH_READONLY02_API_KEY
api_secret = REPLACE_WITH_READONLY02_API_SECRET

[account.acc01.strategy]
equity_recovery_take_profit_enabled = false
equity_recovery_trigger_pct = 0.09
equity_recovery_reduce_ratio = 0.50

[account.acc02.strategy]
equity_recovery_take_profit_enabled = false
equity_recovery_trigger_pct = 0.09
equity_recovery_reduce_ratio = 1.0


[account.acc03.strategy]
equity_recovery_take_profit_enabled = false
equity_recovery_trigger_pct = 0.09
equity_recovery_reduce_ratio = 1.0

[account.acc04.strategy]
equity_recovery_take_profit_enabled = false
equity_recovery_trigger_pct = 0.09
equity_recovery_reduce_ratio = 0.50

[account.55.strategy]
fixed_take_profit_enabled = false

[account.acc01.runtime]
portfolio_take_profit_enabled = true
portfolio_take_profit_pct = 2.5
portfolio_take_profit_giveback_pct = 15.0
portfolio_take_profit_hour = 8
portfolio_take_profit_minute = 0
portfolio_take_profit_reduce_ratio = 0.50

[account.acc03.runtime]
daily_loss_cut_enabled = true
portfolio_take_profit_enabled = true
portfolio_take_profit_pct = 2.5
portfolio_take_profit_giveback_pct = 15.0
portfolio_take_profit_hour = 8
portfolio_take_profit_minute = 0
portfolio_take_profit_reduce_ratio = 1.0

[account.acc02.runtime]
entry_hour = 7
entry_minute = 45
entry_initial_delay_sec = 30
entry_symbol_interval_sec = 30
cooling_off_retry_count = 1
cooling_off_retry_delay_sec = 30
portfolio_take_profit_enabled = true
portfolio_take_profit_pct = 2.5
portfolio_take_profit_giveback_pct = 15.0
portfolio_take_profit_hour = 8
portfolio_take_profit_minute = 0
portfolio_take_profit_reduce_ratio = 1.0

[account.acc04.runtime]
portfolio_take_profit_enabled = false


[account.55.runtime]
daily_loss_cut_enabled = false
daily_loss_cut_scope = exchange
morning_protection_enabled = false
morning_protection_hour = 7
morning_protection_minute = 55
morning_protection_min_hold_hours = 6
hourly_exchange_take_profit_enabled = true
hourly_exchange_take_profit_minute = 0
hourly_exchange_take_profit_drop_pct = 18
# 账户级保护白名单。
# 仅支持精确 symbol 匹配，程序内部会自动转成大写。
# 单个 symbol 示例：protection_exempt_symbols = XAUUSDT
# 多个 symbol 示例：protection_exempt_symbols = XAUUSDT,BTCUSDT,ETHUSDT
protection_exempt_symbols = XAUUSDT

[notify]
enabled = true
serverchan_sendkey =
http_proxy =
https_proxy =
